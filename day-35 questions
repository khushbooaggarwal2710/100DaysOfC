Q69 Find the second largest element in an array.

#include <stdio.h>
int main(void) 
{
    int a[100], n, largest, second;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    largest = second = a[0];

    for (int i = 1; i < n; i++) 
    {
        if (a[i] > largest)
        {
            second = largest;
            largest = a[i];
        } else if (a[i] > second && a[i] != largest) 
        {
            second = a[i];
        }
    }

    printf("Second largest = %d", second);

    return 0;
}

Q70: Rotate an array to the right by k positions.

#include <stdio.h>
int main(void) 
{
    int a[3], b[3], n, k;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &k);
    k = k % n;

    for (int i = 0; i < n; i++)
        b[(i + k) % n] = a[i];

    for (int i = 0; i < n; i++)
        printf("%d ", b[i]);

    return 0;
}
