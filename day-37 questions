Q73 Find the sum of each row of a matrix and store it in an array.

#include <stdio.h>

int main(void) 
{
    int a[10][10], sum[10] = {0};
    int r,c;

    scanf("%d %d", &r,&c);

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &a[i][j]);
            sum[i] += a[i][j];
        }
    }

    for (int i = 0; i < r; i++)
        printf("%d ", sum[i]);

    return 0;
}  

Q74: Find the transpose of a matrix.

  #include <stdio.h>

int main() {
    int a[10][10], trans[10][10];
    int r,c;

    scanf("%d %d", &r,&c);

    for (int i=0; i<r; i++)
        for (int j=0; j<c; j++)
            scanf("%d", &a[i][j]);

    for (int i=0; i<r; i++)
        for (int j=0; j<c; j++)
            trans[j][i] = a[i][j];

    for (int i=0; i<c; i++)
    {
        for (int j = 0; j<r; j++)
            printf("%d ", trans[i][j]);

        printf("\n");
    }

    return 0;
}
