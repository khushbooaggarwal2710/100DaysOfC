Q57 Find the sum of array elements.

#include <stdio.h>

int main(void) {
    int a[5], n, i, sum = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        sum += a[i];
    }

    printf("Sum of array elements = %d\n", sum);

    return 0;
}

Q58 Find the maximum and minimum element in an array.

#include <stdio.h>

int main(void) {
    int a[5],n,i,max,min;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);

    for (i=0; i<n; i++) {
        scanf("%d", &a[i]);
    }

    maximum = a[0];
    minimum = a[0];

    for (i=1; i<n; i++) {
        if (a[i]>maximum) {
            maximum = a[i];
        }

        if (a[i]<minimum) {
            minimum = a[i];
        }
    }

    printf("Maximum element = %d\n", maximum);
    printf("Minimum element = %d\n", minimum);

    return 0;
}
