Q93: Check if two strings are anagrams of each other.

#include <stdio.h>
int main(void)
{
    char a[100], b[100];
    int count[26]={0};
    int i;

    scanf("%s",a);
    scanf("%s",b);

    for(i=0; a[i]!='\0'; i++)
        count[a[i]-'a']++;

    for(i=0; b[i]!='\0'; i++)
        count[b[i]-'a']--;

    for(i=0; i<26; i++)
    {
        if(count[i]!=0)
        {
            printf("Not anagrams");
            return 0;
        }
    }

    printf("Anagrams");
    return 0;
}

Q94: Find the longest word in a sentence.

#include <stdio.h>
int main(void)
{
    char str[100];
    int i,count=0,max=0,start=0,maxStart=0;

    fgets(str,100,stdin);

    for(i=0;  i++)
    {
        if(str[i] != ' ' && str[i] != '\n' && str[i] != '\0')
        {
            count++;
        }
        else
        {
            if(count>max)
            {
                max=count;
                maxStart=start;
            }

            count=0;
            start=i+1;
        }

        if(str[i]=='\0')
            break;
    }

    for(i=maxStart; i<maxStart+max; i++)
        printf("%c",str[i]);

    return 0;
}
