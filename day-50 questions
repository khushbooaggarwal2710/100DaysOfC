Q99: Change the date format from dd/04/yyyy to dd-Apr-yyyy.

#include <stdio.h>
int main(void)
{
    int dd, yyyy;

    scanf("%d/04/%d", &dd, &yyyy);
    printf("%02d-Apr-%d", dd, yyyy);

    return 0;
}

Q100: Print all sub-strings of a string.

#include <stdio.h>
int main(void)
{
    char str[100];
    int i,j,k;

    scanf("%s",str);

    for(i=0; str[i]!='\0'; i++)
    {
        for(j=i; str[j]!='\0'; j++)
        {
            for(k=i; k<=j; k++)
            {
                printf("%c",str[k]);
            }
            printf("\n");
        }
    }
    return 0;
}
