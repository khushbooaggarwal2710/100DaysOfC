Q97: Print the initials of a name.

#include <stdio.h>
int main(void)
{
    char name[50];
    int i;

    fgets(name,100,stdin);

    printf("%c",name[0]);

    for(i=0; name[i]!='\0'; i++)
    {
        if(name[i]==' ' && name[i + 1]!=' ')
            printf("%c",name[i + 1]);
    }
    return 0;
}

Q98: Print initials of a name with the surname displayed in full.

#include <stdio.h>
int main(void)
{
    char name[50];
    int i,last=0;

    fgets(name,100,stdin);

    printf("%c.",name[0]);

    for(i=0; name[i]!='\0'; i++)
    {
        if(name[i]==' ')
        {
            last=i+1;

            if(name[i+1]!='\0')
                printf("%c. ",name[i + 1]);
        }
    }

    for(i = last; name[i] != '\0' && name[i] != '\n'; i++)
        printf("%c", name[i]);

    return 0;
}
