Q47 Write a program to print the following pattern:
*
**
***
****
*****

#include <stdio.h>

int main()
{
    int r;

    printf("Enter number of rows");
    scanf("%d",&r);

    for (int i=1; i<=r; i++)
        {
        for (int j =1; j<=i; j++)
        {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}

Q48 Write a program to print the following pattern:
1
12
123
1234
12345

#include <stdio.h>

int main() 
{
    int rows;

    printf("Enter number of rows: ");
    scanf("%d", &rows);

    for (int i = 1; i <= rows; i++) 
        {
        for (int j = 1; j <= i; j++)
         {
            printf("%d", j);
         }
            printf("\n");
    }

    return 0;
}
