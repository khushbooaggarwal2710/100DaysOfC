ques-27 Write a program to print the sum of the first n odd numbers.

#include <stdio.h>

int main()
{
    int n, sum = 0;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) 
    {
        sum = sum + (2 * i - 1);
    }

    printf("Sum = %d", sum);

    return 0;
}

ques-28 Write a program to print the product of even numbers from 1 to n.

#include <stdio.h>

int main() 
{
    int n, product = 1;

    printf("Enter the value of n");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) 
{
        product = product * i;
    }

    printf("Product = %d", product);

    return 0;
}
