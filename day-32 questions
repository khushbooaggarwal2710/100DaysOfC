Q63Merge two arrays.

  #include <stdio.h>

int main(void)
{
    int a[50], b[50], c[100];
    int n, m, i;

    scanf("%d", &n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &m);
    for (i = 0; i < m; i++)
        scanf("%d", &b[i]);

    for (i = 0; i < n; i++)
        c[i] = a[i];

    for (i = 0; i < m; i++)
        c[n + i] = b[i];

    for (i = 0; i < n + m; i++)
        printf("%d ", c[i]);

    return 0;
}

Q64Find the digit that occurs the most times in an integer number.

#include<stdio.h>
int main(void)
{
    long long n;
    int count[10] = {0}, digit, max = 0, answer = 0;

    scanf("%lld", &n);

    if (n < 0)
        n = -n;

    if (n == 0)
        count[0] = 1;

    while (n > 0)
    {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }

    for (digit = 0; digit <= 9; digit++)
    {
        if (count[digit] > max)
        {
            max = count[digit];
            answer = digit;
        }
    }

    printf("Most frequent digit: %d", answer);

    return 0;
}
