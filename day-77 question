Q127: Write a program that reads text from input.txt, converts all lowercase letters to uppercase, and writes the result to output.txt.

#include <stdio.h>
int main(void)
{
    FILE *input, *output;
    int ch;

    input = fopen("input.txt", "r");

    if(input == NULL)
    {
        printf("input.txt could not be opened.");
        return 1;
    }

    output = fopen("output.txt", "w");

    if(output == NULL)
    {
        printf("output.txt could not be opened.");
        fclose(input);
        return 1;
    }

    while((ch = fgetc(input)) != EOF)
    {
        // Convert lowercase to uppercase
        if(ch >= 'a' && ch <= 'z')
        {
            ch = ch - 32;
        }

        // Write character to output.txt
        fputc(ch, output);
    }

    fclose(input);
    fclose(output);

    printf("Text converted successfully.");

    return 0;
}
