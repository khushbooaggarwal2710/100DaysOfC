ques-11  Write a program to input an integer and check whether it is even or odd using if–else.

#include <stdio.h>
int main()
{
    int no;

    printf("Enter an no ");
    scanf("%d", &no);

    if (no % 2 == 0)
    {
        printf("%d is an Even number.\n", no);
    } 
else
    {
        printf("%d is an Odd number.\n", no);
    }

    return 0;
}

