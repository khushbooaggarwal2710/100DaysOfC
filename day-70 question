Q120: Write a program to take a string input. Change it to sentence case.

#include <stdio.h>
#include <string.h>
int main()
{
    char str[100];
    int i;

    printf("Enter a string: ");
    fgets(str, 100, stdin);

    // Convert all capital letters to small letters
    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'A' && str[i] <= 'Z')
        {
            str[i] = str[i] + 32;
        }
    }

    // Convert first letter to capital
    if(str[0] >= 'a' && str[0] <= 'z')
    {
        str[0] = str[0] - 32;
    }

    printf("Sentence case: %s", str);

    return 0;
}
