Q43 Write a program to check if a number is a strong number.

#include<stdio.h>
int main(void)
{
    int n,ori,digit,fact,sum=0,i;
    
    printf("Enter a number:");
    scanf("%d",&n);
    
    ori=n;
    
    while(n!=0)
    {
        digit=n%10;
        
        fact=1;
        
        for(i=1; i<=digit; i++)
        {
            fact=fact*i;
        }
        
        sum=sum+fact;
        
        n=n/10;
    }
    if(sum==ori)
    {
        printf("%d is a strong number\n",ori);
    }
    else{
        printf("%d is not a strong number\n",ori);
    }
    
    return 0;
}

Q44 Write a program to find the sum of the series: 1 + 3/4 + 5/6 + 7/8 + … up to n terms.

#include<stdio.h>
int main(void)
{
   int n,i;
   float sum=1,num,denom;

   printf("Enter the no of terms");
   scanf("%d",&n);

   for(i=2; i<=n; i++)
 {
    num=2*i-1;
    denom=2*i;

    sum=sum +num/denom;
 }

  printf("Sum of the series =0.2f\n",sum);

  return 0;
}
