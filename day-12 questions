ques-23 Write a program to calculate library fine based on late days as follows: 
First 5 days late: ₹2/day 
Next 5 days late: ₹4/day 
Next 20 days days late: ₹6/day 
More than 30 days: Membership Cancelled.

#include <stdio.h>

int main() {
    int days,fine;

    printf("Enter late days");
    scanf("%d", &days);

    if (days <= 5)
        fine = days * 2;
    else if (days <= 10)
        fine = 5 * 2 + (days - 5) * 4;
    else if (days <= 30)
        fine = 5 * 2 + 5 * 4 + (days - 10) * 6;
    else {
        printf("Membership Cancelled");
    }
    printf("Library Fine = Rs.%d", fine);
    return 0;
}

ques-24 Write a program to calculate electricity bill based on units consumed with these rates: 
First 100 units at ₹5/unit 
Next 100 units at ₹7/unit 
Next 100 units at ₹10/unit 
Above at ₹12/unit

#include <stdio.h>

int main() {
    int u, bill;

    printf("Enter units");
    scanf("%d", &u);

    if (u <= 100)
        bill = u * 5;
    else if (u <= 200)
        bill = 500 + (u - 100) * 7;
    else if (u <= 300)
        bill = 1200 + (u - 200) * 10;
    else
        bill = 2200 + (u - 300) * 12;

    printf("Bill = Rs.%d", bill);
    return 0;
}
