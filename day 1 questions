QUESTION-1 Write a program to input two numbers and display their sum.
#include <stdio.h>
int main()
{
    int a,b,c;
    printf("Enter any two numbers: ");
    scanf("%d %d",&a,&b);
    c=a+b;
    printf("sum of two numbers is %d",c);
    return 0;
}


QUESTION-2 Write a program to input two numbers and display their sum, difference, product, and quotient.
#include <stdio.h>
int main()
{
    int a,b,c,d,e;
    float f;
    printf("Enter any two numbers: ");
    scanf("%d %d",&a,&b);
    c=a+b;
    d=a-b;
    e=a*b;
    f=a%b;
    printf("sum of two numbers is %d",c);
    printf("difference of two numbers is %d",d);
    printf("product of two numbers is %d",e);
    printf("quotient of two numbers is %f",f);
    return 0;
}
