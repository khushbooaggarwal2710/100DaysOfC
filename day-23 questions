Q45 Write a program to find the sum of the series: 2/3 + 4/7 + 6/11 + 8/15 + ... up to n terms.

#include <stdio.h>

int main(void)
{
    int n;
    double sum =0.0;

    printf("Enter the number of terms: ");
    scanf("%d",&n);

    for(int i=1;i<=n; i++) 
    {
        sum +=(double)(2*i)/(4*i-1);
    }

    printf("Sum of the series = %.6f\n",sum);

    return 0;
}

